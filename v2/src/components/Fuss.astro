---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { navigation, social, verein, mailto, tel } from "../data/site";
import { standorte } from "../data/standorte";
import { url } from "../lib/url";
import SocialIcon from "./SocialIcon.astro";

const jahr = new Date().getFullYear();
---

<footer class="fuss">
  <div class="container">
    <div class="spalten">
      <div class="marke">
        <Image src={logo} alt="Logo Coworking Eichsfeld" width={88} height={88} />
        <p class="slogan">{verein.slogan}</p>
        <ul class="social">
          {social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" aria-label={s.name}>
                <SocialIcon name={s.name} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      {standorte.map((s) => (
        <div>
          <h2>{s.name}</h2>
          <p>
            {s.adresse.split(", ").map((z) => (<>{z}<br /></>))}
            <a href={tel(s.telefon)}>{s.telefon}</a>
          </p>
          <a href={url("/" + s.slug)}>Zum Standort →</a>
        </div>
      ))}

      <div>
        <h2>Kontakt</h2>
        <p>
          <a href={mailto()}>{verein.email}</a><br />
          Zentral: <a href={tel(verein.telefonZentral)}>{verein.telefonZentral}</a>
        </p>
        <h2 class="mt">Seiten</h2>
        <ul class="links">
          {navigation.map((n) => <li><a href={url(n.pfad)}>{n.titel}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="unten">
      <p>© {jahr} {verein.name}</p>
      <ul>
        <li><a href={url("/impressum")}>Impressum</a></li>
        <li><a href={url("/datenschutz")}>Datenschutz</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .fuss {
    background: var(--gruen-dunkel);
    color: rgb(255 255 255 / 0.82);
    padding-block: 64px 28px;
    font-size: 0.95rem;
  }
  .fuss a {
    color: #fff;
  }
  .fuss a:hover {
    color: var(--akzent);
  }
  h2 {
    color: #fff;
    font-size: 0.85rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 1em;
  }
  h2.mt {
    margin-top: 1.6em;
  }
  .spalten {
    display: grid;
    gap: 36px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }
  .marke img {
    background: #fff;
    border-radius: 50%;
  }
  .slogan {
    margin-top: 16px;
    font-weight: 300;
    font-style: italic;
  }
  .social,
  .links,
  .unten ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .social {
    display: flex;
    gap: 10px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.3);
  }
  .social a:hover {
    background: #fff;
    color: var(--gruen);
  }
  .links {
    display: grid;
    gap: 4px;
  }
  .links a {
    text-decoration: none;
  }
  .unten {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
  }
  .unten p {
    margin: 0;
  }
  .unten ul {
    display: flex;
    gap: 20px;
  }
</style>
