---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";
import { navigation, verein } from "../data/site";
import { url } from "../lib/url";

const aktuell = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ""), "").replace(/\/$/, "") || "/";
const istAktiv = (pfad: string) => aktuell === pfad || aktuell.startsWith(pfad + "/");
---

<header class="kopfleiste">
  <div class="container innen">
    <a class="marke" href={url("/")} aria-label="Coworking Eichsfeld – Startseite">
      <Image src={logo} alt="" width={52} height={52} loading="eager" />
      <span>Coworking<strong>Eichsfeld</strong></span>
    </a>

    <nav class="nav-gross" aria-label="Hauptnavigation">
      <ul>
        {navigation.map((n) => (
          <li>
            <a href={url(n.pfad)} aria-current={istAktiv(n.pfad) ? "page" : undefined}>{n.titel}</a>
          </li>
        ))}
      </ul>
      <a class="knopf knopf--akzent" href={verein.buchung} target="_blank" rel="noopener">Platz buchen</a>
    </nav>

    <details class="nav-klein">
      <summary aria-label="Menü öffnen">
        <span class="balken" aria-hidden="true"></span>
        <span class="text">Menü</span>
      </summary>
      <nav aria-label="Hauptnavigation (mobil)">
        <ul>
          {navigation.map((n) => (
            <li>
              <a href={url(n.pfad)} aria-current={istAktiv(n.pfad) ? "page" : undefined}>{n.titel}</a>
            </li>
          ))}
        </ul>
        <a class="knopf knopf--akzent" href={verein.buchung} target="_blank" rel="noopener">Platz buchen</a>
      </nav>
    </details>
  </div>
</header>

<style>
  .kopfleiste {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(247 246 242 / 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linie);
  }
  .innen {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 76px;
  }
  .marke {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--gruen-dunkel);
    font-size: 1.05rem;
    line-height: 1.1;
    flex-shrink: 0;
  }
  .marke span {
    display: flex;
    flex-direction: column;
    font-weight: 300;
  }
  .marke strong {
    font-weight: 600;
  }
  .nav-gross {
    display: none;
    align-items: center;
    gap: 20px;
  }
  .nav-gross ul,
  .nav-klein ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-gross ul {
    display: flex;
    gap: 4px;
  }
  .nav-gross a:not(.knopf) {
    display: block;
    padding: 8px 10px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
  }
  .nav-gross a:not(.knopf):hover {
    background: var(--gruen-hell);
    color: var(--gruen-dunkel);
  }
  .nav-gross a[aria-current="page"],
  .nav-klein a[aria-current="page"] {
    color: var(--gruen);
    box-shadow: inset 0 -2px 0 var(--akzent);
    border-radius: 0;
  }
  .nav-gross .knopf {
    padding: 0.6em 1.1em;
  }

  .nav-klein summary {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    padding: 10px 14px;
    border: 1px solid var(--linie);
    border-radius: 999px;
    background: #fff;
    font-weight: 500;
    font-size: 0.95rem;
  }
  .nav-klein summary::-webkit-details-marker {
    display: none;
  }
  .balken,
  .balken::before,
  .balken::after {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--gruen-dunkel);
    border-radius: 2px;
    position: relative;
    transition: transform 0.2s;
  }
  .balken::before,
  .balken::after {
    content: "";
    position: absolute;
  }
  .balken::before {
    top: -6px;
  }
  .balken::after {
    top: 6px;
  }
  .nav-klein[open] .balken {
    background: transparent;
  }
  .nav-klein[open] .balken::before {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-klein[open] .balken::after {
    transform: translateY(-6px) rotate(-45deg);
  }
  .nav-klein nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--hintergrund);
    border-bottom: 1px solid var(--linie);
    padding: 8px var(--rand) 24px;
    box-shadow: 0 16px 24px rgb(0 0 0 / 0.08);
  }
  .nav-klein li a {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid var(--linie);
    text-decoration: none;
    color: var(--text);
    font-weight: 500;
    font-size: 1.1rem;
  }
  .nav-klein .knopf {
    margin-top: 20px;
  }

  @media (min-width: 1100px) {
    .nav-gross {
      display: flex;
    }
    .nav-klein {
      display: none;
    }
  }
</style>
