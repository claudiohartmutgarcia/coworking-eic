---
import Seite from "../layouts/Seite.astro";
import Seitenkopf from "../components/Seitenkopf.astro";
import { verein, mailto, tel } from "../data/site";
import { standorte } from "../data/standorte";
import { url } from "../lib/url";

// Kein eingebettetes Kartenfenster (das würde schon beim Laden Daten an Google senden),
// sondern Links, die die Route erst auf Klick in OpenStreetMap öffnen.
const karte = (adresse: string) => `https://www.openstreetmap.org/search?query=${encodeURIComponent(adresse)}`;
const anfrageMail =
  `mailto:${verein.email}?subject=${encodeURIComponent("Anfrage über coworking-eic.de")}` +
  `&body=${encodeURIComponent("Hallo Coworking Eichsfeld,\n\n")}`;
---

<Seite titel="Kontakt" beschreibung="So erreichst du Coworking Eichsfeld: Adressen, Telefonnummern, E-Mail und Anfahrt nach Heiligenstadt und Leinefelde.">
  <Seitenkopf
    kicker="Kontakt"
    titel="Neugierig? Komm vorbei!"
    text="Da wir unsere Standorte ehrenamtlich betreiben, schreib uns vorher bitte eine Nachricht. Du hast eine Frage, möchtest uns besuchen oder eine Veranstaltung bei uns machen? Schreib uns einfach."
  >
    <div class="knoepfe">
      <a class="knopf" href={anfrageMail}>E-Mail schreiben</a>
      <a class="knopf knopf--rahmen" href={tel(verein.telefonZentral)}>Zentral: {verein.telefonZentral}</a>
    </div>
  </Seitenkopf>

  <section class="abschnitt abschnitt--weiss">
    <div class="container">
      <div class="orte">
        {standorte.map((s) => (
          <article class="ort karte">
            <h2>{s.name}</h2>
            <p>{s.adresse}</p>
            <dl>
              <dt>Telefon</dt>
              <dd><a href={tel(s.telefon)}>{s.telefon}</a></dd>
              <dt>E-Mail</dt>
              <dd><a href={mailto(`Besuch in ${s.name}`)}>{verein.email}</a></dd>
              <dt>Ansprechpartner</dt>
              <dd>{s.ansprechpartner.name}</dd>
            </dl>
            <div class="knoepfe">
              <a class="knopf knopf--rahmen" href={karte(s.adresse)} target="_blank" rel="noopener">Auf der Karte zeigen</a>
              <a class="knopf knopf--rahmen" href={url("/" + s.slug)}>Zum Standort</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="abschnitt">
    <div class="container zwei-spalten oben">
      <div>
        <span class="kicker">Anfahrt Heiligenstadt</span>
        <h2>Parken & Ankommen</h2>
        <p>
          Parkmöglichkeiten in Heiligenstadt: Karl-Liebknecht-Platz, Krankenhaus, Fressnapf oder an der Stadthalle. Am besten vorher die
          <a href="https://www.paybyphone.de/app" target="_blank" rel="noopener">PayByPhone-App</a> herunterladen.
        </p>
        <p>
          Es gibt zwei Eingänge: den Haupteingang von der Wilhelmstraße kommend über den Parkplatz sowie den barrierefreien Eingang über den Fahrstuhl von der Windischen Gasse aus.
        </p>
      </div>
      <figure class="video">
        <video controls preload="metadata" playsinline src={url("/videos/weg-in-den-space.mp4") + "#t=1"}>
          <a href={url("/videos/weg-in-den-space.mp4")}>Video ansehen</a>
        </video>
        <figcaption>Noch nie im Space Heiligenstadt gewesen? So findest du rein.</figcaption>
      </figure>
    </div>
  </section>
</Seite>

<style>
  .orte {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 880px) {
    .orte {
      grid-template-columns: 1fr 1fr;
    }
  }
  .ort {
    padding: 32px;
    background: var(--hintergrund);
    box-shadow: none;
  }
  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 20px;
    margin: 0 0 24px;
  }
  dt {
    color: var(--text-leise);
    font-size: 0.9rem;
  }
  dd {
    margin: 0;
  }
  .oben {
    align-items: start;
  }
  .video {
    margin: 0;
  }
  .video video {
    width: 100%;
    max-height: 560px;
    border-radius: var(--radius);
    background: #000;
  }
  figcaption {
    font-size: 0.85rem;
    color: var(--text-leise);
    margin-top: 10px;
  }
</style>
